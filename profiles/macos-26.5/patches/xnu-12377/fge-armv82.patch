diff --git a/osfmk/arm64/fge.c b/osfmk/arm64/fge.c
new file mode 100644
index 0000000..1d1dabe
--- /dev/null
+++ b/osfmk/arm64/fge.c
@@ -0,0 +1,535 @@
+/*
+ * FGE - Feature Gap Emulation. See fge.h.
+ *
+ * Encodings follow the Arm Architecture Reference Manual (DDI 0487) and are
+ * checked against LLVM's assembler by tests/fge (encodings generated with
+ * llvm-mc at test time, not typed in by hand).
+ *
+ * Copyright (c) 2026, macOS-Pad-6 contributors.
+ * SPDX-License-Identifier: BSD-2-Clause-Patent
+ */
+#include "fge.h"
+
+#define BITS(v, hi, lo) (((v) >> (lo)) & ((1u << ((hi) - (lo) + 1)) - 1u))
+
+/* ---- register helpers -------------------------------------------------- */
+
+static inline fge_u64
+rx(const fge_ctx_t *c, unsigned n)          /* Xn, 31 = XZR */
+{
+	return n == 31 ? 0 : c->x[n];
+}
+
+static inline fge_u64
+rxsp(const fge_ctx_t *c, unsigned n)        /* Xn|SP */
+{
+	return n == 31 ? c->sp : c->x[n];
+}
+
+static inline void
+wx(fge_ctx_t *c, unsigned n, fge_u64 v)
+{
+	if (n != 31) {
+		c->x[n] = v;
+	}
+}
+
+static inline void
+wxsp(fge_ctx_t *c, unsigned n, fge_u64 v)
+{
+	if (n == 31) {
+		c->sp = v;
+	} else {
+		c->x[n] = v;
+	}
+}
+
+static inline fge_s64
+sext(fge_u64 v, unsigned bits)
+{
+	fge_u64 m = 1ull << (bits - 1);
+	v &= (bits == 64) ? ~0ull : ((1ull << bits) - 1);
+	return (fge_s64)((v ^ m) - m);
+}
+
+/* ---- classification ---------------------------------------------------- */
+
+static int
+is_pac_dp1(fge_u32 i)
+{
+	unsigned op, rn;
+
+	if ((i & 0xFFFF0000u) != 0xDAC10000u) {   /* opcode in bits 15..10 */
+		return 0;
+	}
+	op = BITS(i, 15, 10);
+	rn = BITS(i, 9, 5);
+	if (op <= 7) {
+		return 1;                   /* PACIA..AUTDB: Xn|SP modifier */
+	}
+	if (op <= 17) {
+		return rn == 31;            /* *Z forms and XPACI/XPACD need Rn = 11111 */
+	}
+	return 0;
+}
+
+static int
+is_pacga(fge_u32 i)
+{
+	return (i & 0xFFE0FC00u) == 0x9AC03000u;
+}
+
+/* BRAA(Z)/BRAB(Z)/BLRAA(Z)/BLRAB(Z)/RETAA/RETAB. ERETAA/ERETAB are left alone. */
+static int
+is_pac_branch(fge_u32 i)
+{
+	unsigned opc, op3, rn, op4;
+
+	if ((i >> 25) != 0x6Bu || BITS(i, 20, 16) != 31) {
+		return 0;
+	}
+	opc = BITS(i, 24, 21);
+	op3 = BITS(i, 15, 10);
+	rn = BITS(i, 9, 5);
+	op4 = BITS(i, 4, 0);
+	if (op3 != 2 && op3 != 3) {
+		return 0;
+	}
+	switch (opc) {
+	case 0: /* BRAAZ, BRABZ */
+	case 1: /* BLRAAZ, BLRABZ */
+		return op4 == 31;
+	case 2: /* RETAA, RETAB */
+		return rn == 31 && op4 == 31;
+	case 8: /* BRAA, BRAB */
+	case 9: /* BLRAA, BLRAB */
+		return 1;
+	default:
+		return 0;
+	}
+}
+
+static int
+is_pac_load(fge_u32 i)
+{
+	return (i & 0xFF200400u) == 0xF8200400u;
+}
+
+/* MSR/MRS with op0=3 op1=0 CRn=2 CRm=1..3: APIAKey..APGAKey (Lo/Hi). */
+static int
+is_pac_keyreg(fge_u32 i)
+{
+	unsigned crm, op2;
+
+	if ((i & 0xFFDFF000u) != 0xD5182000u) {   /* L in bit 21 */
+		return 0;
+	}
+	crm = BITS(i, 11, 8);
+	op2 = BITS(i, 7, 5);
+	if (crm == 1 || crm == 2) {
+		return op2 <= 3;
+	}
+	if (crm == 3) {
+		return op2 <= 1;
+	}
+	return 0;
+}
+
+static int
+is_jscvt(fge_u32 i)
+{
+	return (i & 0xFFFFFC00u) == 0x1E7E0000u;
+}
+
+#define INSN_CFINV  0xD500401Fu
+#define INSN_XAFLAG 0xD500403Fu
+#define INSN_AXFLAG 0xD500405Fu
+#define INSN_SB     0xD50330FFu
+
+static int
+is_rmif(fge_u32 i)
+{
+	return (i & 0xFFE07C10u) == 0xBA000400u;
+}
+
+static int
+is_setf(fge_u32 i)
+{
+	return (i & 0xFFFFBC1Fu) == 0x3A00080Du;   /* bit 14: SETF16 */
+}
+
+static int
+is_rcpc2(fge_u32 i)
+{
+	unsigned size, opc;
+
+	if ((i & 0x3F200C00u) != 0x19000000u) {
+		return 0;
+	}
+	size = BITS(i, 31, 30);
+	opc = BITS(i, 23, 22);
+	if (size == 2 && opc == 3) {
+		return 0;
+	}
+	if (size == 3 && opc >= 2) {
+		return 0;
+	}
+	return 1;
+}
+
+/* MSR DIT, #imm (op1=3, op2=2); MSR SSBS, #imm (op1=3, op2=1). */
+static int
+is_pstate_imm(fge_u32 i)
+{
+	return (i & 0xFFFFF0FFu) == 0xD503405Fu || (i & 0xFFFFF0FFu) == 0xD503403Fu;
+}
+
+/* MRS/MSR Xt, DIT (S3_3_C4_C2_5). */
+static int
+is_dit_reg(fge_u32 i)
+{
+	return (i & 0xFFDFFFE0u) == 0xD51B42A0u;
+}
+
+fge_class_t
+fge_classify(fge_u32 i, int el)
+{
+	if (is_pac_dp1(i)) {
+		return FGE_CLASS_PAC_DP1;
+	}
+	if (is_pacga(i)) {
+		return FGE_CLASS_PACGA;
+	}
+	if (is_pac_branch(i)) {
+		return FGE_CLASS_PAC_BRANCH;
+	}
+	if (is_pac_load(i)) {
+		return FGE_CLASS_PAC_LOAD;
+	}
+	if (el == 1 && is_pac_keyreg(i)) {
+		return FGE_CLASS_PAC_KEYREG;
+	}
+	if (is_jscvt(i)) {
+		return FGE_CLASS_JSCVT;
+	}
+	/* Canonical encodings only: the should-be-zero CRm of CFINV/AXFLAG/XAFLAG
+	 * is never set by an assembler. */
+	if (i == INSN_CFINV || is_rmif(i) || is_setf(i)) {
+		return FGE_CLASS_FLAGM;
+	}
+	if (i == INSN_AXFLAG || i == INSN_XAFLAG) {
+		return FGE_CLASS_FLAGM2;
+	}
+	if (i == INSN_SB) {
+		return FGE_CLASS_SB;
+	}
+	if (is_rcpc2(i)) {
+		return FGE_CLASS_RCPC2;
+	}
+	if (is_pstate_imm(i) || is_dit_reg(i)) {
+		return FGE_CLASS_PSTATE;
+	}
+	return FGE_CLASS_NONE;
+}
+
+const char *
+fge_class_name(fge_class_t cls)
+{
+	static const char *const names[FGE_CLASS_COUNT] = {
+		"none", "pac-dp1", "pacga", "pac-branch", "pac-load", "pac-keyreg",
+		"jscvt", "flagm", "flagm2", "sb", "rcpc2", "pstate",
+	};
+	return ((unsigned)cls < FGE_CLASS_COUNT) ? names[cls] : "?";
+}
+
+/* ---- FJCVTZS ----------------------------------------------------------- */
+
+/*
+ * Arm pseudocode FPToFixedJS(): round toward zero, result modulo 2^32,
+ * Z = 1 only for an exact, in-range, non-negative-zero conversion.
+ * Integer-only so that it is safe in kernel context.
+ */
+fge_u32
+fge_fjcvtzs(fge_u64 bits, fge_u32 fpcr, int *z, fge_u32 *fpsr_bits)
+{
+	unsigned sign = (unsigned)(bits >> 63);
+	unsigned exp = (unsigned)((bits >> 52) & 0x7FF);
+	fge_u64 frac = bits & ((1ull << 52) - 1);
+	fge_u64 m, int_abs, low32;
+	int e, inexact = 0, overflow = 0;
+	fge_u32 res;
+
+	*z = 1;
+	*fpsr_bits = 0;
+
+	if (exp == 0x7FF) {                       /* Inf or NaN */
+		*z = 0;
+		*fpsr_bits |= FGE_FPSR_IOC;
+		return 0;
+	}
+	if (exp == 0 && frac != 0 && (fpcr & FGE_FPCR_FZ)) {
+		*z = 0;                               /* flushed denormal: value 0 */
+		*fpsr_bits |= FGE_FPSR_IDC;
+		return 0;
+	}
+	if (exp == 0 && frac == 0) {
+		*z = sign ? 0 : 1;                    /* -0.0 clears Z */
+		return 0;
+	}
+
+	m = exp ? ((1ull << 52) | frac) : frac;
+	e = (exp ? (int)exp : 1) - 1075;          /* value = m * 2^e */
+
+	if (e >= 0) {
+		/* |value| >= 2^52: out of int32 range; keep the low 32 bits. */
+		overflow = 1;
+		low32 = (e >= 32) ? 0 : ((m << e) & 0xFFFFFFFFull);
+	} else {
+		unsigned sh = (unsigned)(-e);
+		if (sh >= 64) {
+			int_abs = 0;
+			inexact = 1;
+		} else {
+			int_abs = m >> sh;
+			inexact = (m & ((1ull << sh) - 1)) != 0;
+		}
+		if (sign ? (int_abs > 0x80000000ull) : (int_abs > 0x7FFFFFFFull)) {
+			overflow = 1;
+		}
+		low32 = int_abs & 0xFFFFFFFFull;
+	}
+
+	res = (fge_u32)low32;
+	if (sign) {
+		res = (fge_u32)(0u - res);
+	}
+
+	if (overflow) {
+		*z = 0;
+		*fpsr_bits |= FGE_FPSR_IOC;
+	} else if (inexact) {
+		*z = 0;
+		*fpsr_bits |= FGE_FPSR_IXC;
+	}
+	return res;
+}
+
+/* ---- emulation --------------------------------------------------------- */
+
+static fge_u64
+pacga_mix(fge_u64 a, fge_u64 b, fge_u64 key)
+{
+	/* Deterministic per boot; any function works because every PACGA value
+	 * that is later compared was produced by this same function. */
+	fge_u64 h = a ^ (key + 0x9E3779B97F4A7C15ull);
+	h ^= b + 0xBF58476D1CE4E5B9ull + (h << 6) + (h >> 2);
+	h ^= h >> 30;
+	h *= 0xBF58476D1CE4E5B9ull;
+	h ^= h >> 27;
+	h *= 0x94D049BB133111EBull;
+	h ^= h >> 31;
+	return (h & 0xFFFFFFFFull) << 32;
+}
+
+static fge_u32
+flags_of(int n, int z, int c, int v)
+{
+	return (n ? FGE_N : 0) | (z ? FGE_Z : 0) | (c ? FGE_C : 0) | (v ? FGE_V : 0);
+}
+
+static fge_result_t
+emu_flagm(fge_ctx_t *c, fge_u32 i)
+{
+	fge_u32 f = c->nzcv;
+	int n = !!(f & FGE_N), z = !!(f & FGE_Z), cy = !!(f & FGE_C), v = !!(f & FGE_V);
+
+	if (i == INSN_CFINV) {
+		cy = !cy;
+	} else if (i == INSN_XAFLAG) {
+		int n2 = !cy && !z, z2 = z && cy, c2 = cy || z, v2 = !cy && z;
+		n = n2; z = z2; cy = c2; v = v2;
+	} else if (i == INSN_AXFLAG) {
+		int z2 = z || v, c2 = cy && !v;
+		n = 0; z = z2; cy = c2; v = 0;
+	} else if (is_rmif(i)) {
+		unsigned sh = BITS(i, 20, 15), mask = BITS(i, 3, 0);
+		fge_u64 xn = rx(c, BITS(i, 9, 5));
+		fge_u64 t = sh ? ((xn >> sh) | (xn << (64 - sh))) : xn;
+		if (mask & 8) { n = (int)((t >> 3) & 1); }
+		if (mask & 4) { z = (int)((t >> 2) & 1); }
+		if (mask & 2) { cy = (int)((t >> 1) & 1); }
+		if (mask & 1) { v = (int)(t & 1); }
+	} else { /* SETF8 / SETF16 */
+		unsigned w = (unsigned)rx(c, BITS(i, 9, 5));
+		unsigned top = (i & (1u << 14)) ? 15 : 7;
+		fge_u32 lowmask = (top == 15) ? 0xFFFFu : 0xFFu;
+		n = (int)((w >> top) & 1);
+		z = (w & lowmask) == 0;
+		v = (int)(((w >> (top + 1)) ^ (w >> top)) & 1);
+	}
+	c->nzcv = (c->nzcv & ~(FGE_N | FGE_Z | FGE_C | FGE_V)) | flags_of(n, z, cy, v);
+	return FGE_HANDLED;
+}
+
+static fge_result_t
+emu_rcpc2(fge_ctx_t *c, fge_u32 i)
+{
+	unsigned size = BITS(i, 31, 30), opc = BITS(i, 23, 22);
+	unsigned rn = BITS(i, 9, 5), rt = BITS(i, 4, 0);
+	unsigned nbytes = 1u << size;
+	fge_u64 addr = rxsp(c, rn) + (fge_u64)sext(BITS(i, 20, 12), 9);
+	fge_u64 val = 0;
+
+	if (opc == 0) {                         /* STLUR*: release store */
+		fge_u64 src = rx(c, rt);
+		if (c->write_mem == 0) {
+			return FGE_NOT_HANDLED;
+		}
+		if (c->barrier) {
+			c->barrier(c->cookie);
+		}
+		if (c->write_mem(c->cookie, addr, &src, nbytes) != 0) {   /* little-endian */
+			return FGE_MEM_FAULT;
+		}
+		return FGE_HANDLED;
+	}
+
+	if (c->read_mem == 0) {
+		return FGE_NOT_HANDLED;
+	}
+	if (c->read_mem(c->cookie, addr, &val, nbytes) != 0) {
+		return FGE_MEM_FAULT;
+	}
+	if (c->barrier) {
+		c->barrier(c->cookie);              /* acquire (RCpc) */
+	}
+	if (nbytes < 8) {
+		val &= (1ull << (8 * nbytes)) - 1;
+	}
+	if (opc == 2) {                         /* sign-extend to 64 */
+		val = (fge_u64)sext(val, 8 * nbytes);
+	} else if (opc == 3) {                  /* sign-extend to 32, zero upper */
+		val = (fge_u64)sext(val, 8 * nbytes) & 0xFFFFFFFFull;
+	}
+	wx(c, rt, val);
+	return FGE_HANDLED;
+}
+
+fge_result_t
+fge_emulate(fge_ctx_t *c, fge_u32 i, fge_class_t *out_cls)
+{
+	fge_class_t cls = fge_classify(i, c->el);
+	fge_u64 next = c->pc + 4;
+	fge_result_t r = FGE_HANDLED;
+
+	if (out_cls) {
+		*out_cls = cls;
+	}
+
+	switch (cls) {
+	case FGE_CLASS_NONE:
+		return FGE_NOT_HANDLED;
+
+	case FGE_CLASS_PAC_DP1:
+		/* null PAC: PAC* and AUT* leave Xd unchanged; XPAC* strips nothing
+		 * because nothing was ever signed. */
+		break;
+
+	case FGE_CLASS_PACGA:
+		wx(c, BITS(i, 4, 0),
+		    pacga_mix(rx(c, BITS(i, 9, 5)), rxsp(c, BITS(i, 20, 16)), c->pacga_key));
+		break;
+
+	case FGE_CLASS_PAC_BRANCH: {
+		unsigned opc = BITS(i, 24, 21), rn = BITS(i, 9, 5);
+		fge_u64 target = (opc == 2) ? c->x[30] : rx(c, rn);
+		if (opc == 1 || opc == 9) {
+			c->x[30] = next;                 /* BLRAA*: link after reading Xn */
+		}
+		next = target;
+		break;
+	}
+
+	case FGE_CLASS_PAC_LOAD: {
+		unsigned rn = BITS(i, 9, 5), rt = BITS(i, 4, 0);
+		fge_s64 off = sext((BITS(i, 22, 22) << 9) | BITS(i, 20, 12), 10) * 8;
+		fge_u64 addr = rxsp(c, rn) + (fge_u64)off;
+		fge_u64 val;
+		if (c->read_mem == 0) {
+			return FGE_NOT_HANDLED;
+		}
+		if (c->read_mem(c->cookie, addr, &val, 8) != 0) {
+			return FGE_MEM_FAULT;
+		}
+		if (BITS(i, 11, 11)) {
+			wxsp(c, rn, addr);               /* pre-index writeback */
+		}
+		wx(c, rt, val);
+		break;
+	}
+
+	case FGE_CLASS_PAC_KEYREG:
+		/* No key registers on ARMv8.2: writes are dropped, reads return 0. */
+		if (BITS(i, 21, 21)) {
+			wx(c, BITS(i, 4, 0), 0);
+		}
+		break;
+
+	case FGE_CLASS_JSCVT: {
+		int z;
+		fge_u32 fl, res;
+		if (c->v == 0) {
+			return FGE_NOT_HANDLED;
+		}
+		res = fge_fjcvtzs(c->v[BITS(i, 9, 5)].lo, c->fpcr, &z, &fl);
+		wx(c, BITS(i, 4, 0), (fge_u64)res);  /* W write zero-extends */
+		c->nzcv = (c->nzcv & ~(FGE_N | FGE_Z | FGE_C | FGE_V)) | (z ? FGE_Z : 0);
+		if (c->fpsr) {
+			*c->fpsr |= fl;
+		}
+		break;
+	}
+
+	case FGE_CLASS_FLAGM:
+	case FGE_CLASS_FLAGM2:
+		r = emu_flagm(c, i);
+		break;
+
+	case FGE_CLASS_SB:
+		/* The exception entry and return are context synchronizing and
+		 * stop speculation past this point; nothing more to do. */
+		break;
+
+	case FGE_CLASS_RCPC2:
+		r = emu_rcpc2(c, i);
+		break;
+
+	case FGE_CLASS_PSTATE:
+		/* DIT and SSBS are hints for timing and speculation; the cores
+		 * without them behave as with the feature off. MRS DIT reads 0. */
+		if (is_dit_reg(i) && BITS(i, 21, 21)) {
+			wx(c, BITS(i, 4, 0), 0);
+		}
+		break;
+
+	default:
+		return FGE_NOT_HANDLED;
+	}
+
+	if (r == FGE_HANDLED) {
+		c->pc = next;
+	}
+	return r;
+}
+
+void
+fge_stats_record(fge_stats_t *s, fge_result_t res, fge_class_t cls)
+{
+	if (res == FGE_HANDLED && (unsigned)cls < FGE_CLASS_COUNT) {
+		s->count[cls]++;
+	} else if (res == FGE_MEM_FAULT) {
+		s->faults++;
+	} else {
+		s->not_handled++;
+	}
+}
diff --git a/osfmk/arm64/fge.h b/osfmk/arm64/fge.h
new file mode 100644
index 0000000..82c6490
--- /dev/null
+++ b/osfmk/arm64/fge.h
@@ -0,0 +1,130 @@
+/*
+ * FGE - Feature Gap Emulation for running arm64e (Apple ARMv8.3+) code on
+ * ARMv8.2 cores (Qualcomm Kryo 585 = Cortex-A77 + Cortex-A55, SM8250).
+ *
+ * The library decodes one trapped instruction and emulates it against a
+ * register snapshot. It has no dependency on libc, XNU or the host OS: memory
+ * access, barriers and FP state go through the context, so the same file is
+ * unit-tested on the build host and linked into the kernel by the XNU patch.
+ *
+ * Pointer authentication is emulated as "null PAC": signing and
+ * authentication are the identity function. This is coherent only when every
+ * signature in the system is produced on the device (UniXNU's arm64e profile
+ * already relies on that: "No signature is computed off the device"). It
+ * removes the protection PAC gives. See docs/feasibility.md.
+ *
+ * Copyright (c) 2026, macOS-Pad-6 contributors.
+ * SPDX-License-Identifier: BSD-2-Clause-Patent
+ */
+#ifndef FGE_H
+#define FGE_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if defined(KERNEL) || defined(FGE_FREESTANDING)
+typedef unsigned char      fge_u8;
+typedef unsigned short     fge_u16;
+typedef unsigned int       fge_u32;
+typedef unsigned long long fge_u64;
+typedef long long          fge_s64;
+#else
+#include <stdint.h>
+typedef uint8_t  fge_u8;
+typedef uint16_t fge_u16;
+typedef uint32_t fge_u32;
+typedef uint64_t fge_u64;
+typedef int64_t  fge_s64;
+#endif
+
+/* PSTATE.NZCV bits as they sit in SPSR/CPSR. */
+#define FGE_N (1u << 31)
+#define FGE_Z (1u << 30)
+#define FGE_C (1u << 29)
+#define FGE_V (1u << 28)
+
+/* FPSR cumulative exception bits. */
+#define FGE_FPSR_IOC (1u << 0)
+#define FGE_FPSR_IXC (1u << 4)
+#define FGE_FPSR_IDC (1u << 7)
+/* FPCR.FZ */
+#define FGE_FPCR_FZ  (1u << 24)
+
+typedef struct fge_vreg {
+	fge_u64 lo;
+	fge_u64 hi;
+} fge_vreg_t;
+
+typedef enum fge_class {
+	FGE_CLASS_NONE = 0,
+	FGE_CLASS_PAC_DP1,      /* PACIA..XPACD, AUTIA..AUTDZB (data processing, 1 source) */
+	FGE_CLASS_PACGA,        /* PACGA */
+	FGE_CLASS_PAC_BRANCH,   /* BRAA/BRAB(Z), BLRAA/BLRAB(Z), RETAA/RETAB */
+	FGE_CLASS_PAC_LOAD,     /* LDRAA/LDRAB */
+	FGE_CLASS_PAC_KEYREG,   /* MSR/MRS AP*Key*_EL1 (EL1 only) */
+	FGE_CLASS_JSCVT,        /* FJCVTZS */
+	FGE_CLASS_FLAGM,        /* CFINV, RMIF, SETF8, SETF16 (v8.4) */
+	FGE_CLASS_FLAGM2,       /* AXFLAG, XAFLAG (v8.5) */
+	FGE_CLASS_SB,           /* SB (v8.5) */
+	FGE_CLASS_RCPC2,        /* LDAPUR*, STLUR* (v8.4) */
+	FGE_CLASS_PSTATE,       /* MSR DIT/SSBS, #imm; MRS/MSR DIT */
+	FGE_CLASS_COUNT
+} fge_class_t;
+
+typedef enum fge_result {
+	FGE_NOT_HANDLED = 0,   /* not an instruction FGE knows: deliver SIGILL / panic as before */
+	FGE_HANDLED     = 1,   /* state updated, PC advanced or redirected */
+	FGE_MEM_FAULT   = 2    /* a memory access failed: deliver the fault as before */
+} fge_result_t;
+
+typedef struct fge_ctx {
+	fge_u64 x[31];          /* X0..X30 */
+	fge_u64 sp;             /* SP of the trapping EL */
+	fge_u64 pc;             /* address of the trapping instruction */
+	fge_u32 nzcv;           /* only bits 31..28 are read and written */
+	int     el;             /* 0 = user, 1 = kernel */
+
+	fge_vreg_t *v;          /* V0..V31, or NULL when FP state is not available */
+	fge_u32    *fpsr;       /* may be NULL */
+	fge_u32     fpcr;
+
+	/* Return 0 on success. size is 1, 2, 4 or 8; addr may be unaligned.
+	 * A naturally aligned access must be single-copy atomic, as the
+	 * emulated instruction was (LDAPUR/STLUR implement C11 atomics). */
+	int  (*read_mem)(void *cookie, fge_u64 addr, void *dst, unsigned size);
+	int  (*write_mem)(void *cookie, fge_u64 addr, const void *src, unsigned size);
+	void (*barrier)(void *cookie);   /* full DMB ISH; may be NULL */
+	void *cookie;
+
+	fge_u64 pacga_key;      /* per-boot value mixed into PACGA results */
+} fge_ctx_t;
+
+typedef struct fge_stats {
+	fge_u64 count[FGE_CLASS_COUNT];
+	fge_u64 not_handled;
+	fge_u64 faults;
+} fge_stats_t;
+
+/*
+ * Emulate one instruction. On FGE_HANDLED the context holds the new state
+ * (ctx->pc is the next instruction). On the other results the context is
+ * unchanged. cls, when not NULL, receives the instruction class.
+ */
+fge_result_t fge_emulate(fge_ctx_t *ctx, fge_u32 insn, fge_class_t *cls);
+
+/* Classify without emulating (used by the static audit tests). */
+fge_class_t fge_classify(fge_u32 insn, int el);
+
+const char *fge_class_name(fge_class_t cls);
+
+void fge_stats_record(fge_stats_t *stats, fge_result_t res, fge_class_t cls);
+
+/* FJCVTZS on raw IEEE-754 binary64 bits; exposed for tests. */
+fge_u32 fge_fjcvtzs(fge_u64 bits, fge_u32 fpcr, int *z, fge_u32 *fpsr_bits);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* FGE_H */
diff --git a/osfmk/arm64/fge_xnu.c b/osfmk/arm64/fge_xnu.c
new file mode 100644
index 0000000..44da8a6
--- /dev/null
+++ b/osfmk/arm64/fge_xnu.c
@@ -0,0 +1,200 @@
+/*
+ * XNU glue for FGE. See fge_xnu.h and docs/architecture.md.
+ *
+ * Requirements this file checks or relies on:
+ *  - The kernel collection was rewritten by tools/isa/pacstrip and verified by
+ *    tools/isa/audit (no non-hint PAC instruction left in kernel or kexts).
+ *    Otherwise every kernel function return traps, including this file's.
+ *  - The saved state is not signed with PACGA. With HAS_APPLE_PAC (needed for
+ *    arm64e processes and kexts) that means the null-PAC mode of
+ *    profiles/macos-26.5 (HAS_NULL_PAC: the thread-state hash is constant), so
+ *    registers can be written straight into the saved state.
+ *  - Emulated accesses keep single-copy atomicity for naturally aligned 4- and
+ *    8-byte accesses (copyin_atomic*, copyout_atomic*, or one load/store in
+ *    the kernel); aligned 1- and 2-byte loads read the aligned 32-bit word that
+ *    holds them. Aligned 2-byte stores from user space are copied bytewise.
+ *
+ * Copyright (c) 2026, macOS-Pad-6 contributors.
+ * SPDX-License-Identifier: BSD-2-Clause-Patent
+ */
+#include <arm64/fge.h>
+#include <arm64/fge_xnu.h>
+
+#include <arm/misc_protos.h>
+#include <arm64/proc_reg.h>
+#include <kern/misc_protos.h>
+#include <machine/atomic.h>
+#include <mach/arm/thread_status.h>
+#include <pexpert/pexpert.h>
+
+#if HAS_APPLE_PAC && !HAS_NULL_PAC
+#error "FGE writes the saved state directly; a PACGA-signed thread state needs MANIPULATE_SIGNED_THREAD_STATE here"
+#endif
+
+uint64_t fge_xnu_counts[16];
+
+static int      fge_mode = -1;          /* -1 unread, 0 off, 1 on, 2 on + log */
+static uint64_t fge_key;
+
+static void
+fge_xnu_init(void)
+{
+	int mode = 1;
+
+	if (!PE_parse_boot_argn("fge", &mode, sizeof(mode))) {
+		mode = 1;
+	}
+	fge_key = early_random();
+	fge_mode = mode;                    /* benign race: every reader computes the same */
+}
+
+static int
+fge_read_user(void *cookie __unused, fge_u64 addr, void *dst, unsigned size)
+{
+	uint32_t w;
+	int err;
+
+	if (size == 8 && (addr & 7) == 0) {
+		return copyin_atomic64((user_addr_t)addr, (uint64_t *)dst);
+	}
+	if (size <= 4 && (addr & (size - 1)) == 0) {
+		/* One aligned 32-bit read holds the whole aligned 1, 2 or 4 bytes. */
+		err = copyin_atomic32((user_addr_t)(addr & ~3ull), &w);
+		if (err == 0) {
+			w >>= 8 * (unsigned)(addr & 3);
+			__builtin_memcpy(dst, &w, size);
+		}
+		return err;
+	}
+	return copyin((user_addr_t)addr, (char *)dst, size);
+}
+
+static int
+fge_write_user(void *cookie __unused, fge_u64 addr, const void *src, unsigned size)
+{
+	if (size == 8 && (addr & 7) == 0) {
+		uint64_t v;
+		__builtin_memcpy(&v, src, 8);
+		return copyout_atomic64(v, (user_addr_t)addr);
+	}
+	if (size == 4 && (addr & 3) == 0) {
+		uint32_t v;
+		__builtin_memcpy(&v, src, 4);
+		return copyout_atomic32(v, (user_addr_t)addr);
+	}
+	return copyout((const char *)src, (user_addr_t)addr, size);
+}
+
+static int
+fge_read_kern(void *cookie __unused, fge_u64 addr, void *dst, unsigned size)
+{
+	/* An aligned access is one load, as the original instruction was; a
+	 * bad kernel address faults here exactly as it would have there. */
+	switch ((addr & (size - 1)) == 0 ? size : 0) {
+	case 1: *(uint8_t *)dst = *(volatile uint8_t *)addr; return 0;
+	case 2: { uint16_t v = *(volatile uint16_t *)addr; __builtin_memcpy(dst, &v, 2); return 0; }
+	case 4: { uint32_t v = *(volatile uint32_t *)addr; __builtin_memcpy(dst, &v, 4); return 0; }
+	case 8: { uint64_t v = *(volatile uint64_t *)addr; __builtin_memcpy(dst, &v, 8); return 0; }
+	default: return copyin_kern((user_addr_t)addr, (char *)dst, size);
+	}
+}
+
+static int
+fge_write_kern(void *cookie __unused, fge_u64 addr, const void *src, unsigned size)
+{
+	switch ((addr & (size - 1)) == 0 ? size : 0) {
+	case 1: *(volatile uint8_t *)addr = *(const uint8_t *)src; return 0;
+	case 2: { uint16_t v; __builtin_memcpy(&v, src, 2); *(volatile uint16_t *)addr = v; return 0; }
+	case 4: { uint32_t v; __builtin_memcpy(&v, src, 4); *(volatile uint32_t *)addr = v; return 0; }
+	case 8: { uint64_t v; __builtin_memcpy(&v, src, 8); *(volatile uint64_t *)addr = v; return 0; }
+	default: return copyout_kern((const char *)src, (user_addr_t)addr, size);
+	}
+}
+
+static void
+fge_barrier(void *cookie __unused)
+{
+	__builtin_arm_dmb(DMB_ISH);
+}
+
+bool
+fge_xnu_handle(arm_context_t *context)
+{
+	arm_saved_state_t *state = &context->ss;
+	arm_saved_state64_t *ss;
+	fge_ctx_t ctx;
+	fge_class_t cls = FGE_CLASS_NONE;
+	fge_result_t res;
+	uint32_t insn = 0;
+	bool kernel;
+	unsigned r;
+
+	if (__improbable(fge_mode < 0)) {
+		fge_xnu_init();
+	}
+	if (fge_mode == 0 || !is_saved_state64(state)) {
+		return false;
+	}
+	ss = saved_state64(state);
+	kernel = PSR64_IS_KERNEL(ss->cpsr);
+	if (!kernel && !PSR64_IS_USER64(ss->cpsr)) {
+		return false;
+	}
+
+	if (kernel) {
+		insn = *(volatile uint32_t *)ss->pc;
+	} else if (copyin((user_addr_t)ss->pc, (char *)&insn, sizeof(insn)) != 0) {
+		return false;
+	}
+
+	for (r = 0; r < 29; r++) {
+		ctx.x[r] = ss->x[r];
+	}
+	ctx.x[29] = ss->fp;
+	ctx.x[30] = ss->lr;
+	ctx.sp = ss->sp;
+	ctx.pc = ss->pc;
+	ctx.nzcv = ss->cpsr;
+	ctx.el = kernel ? 1 : 0;
+	if (context->ns.nsh.flavor == ARM_NEON_SAVED_STATE64 &&
+	    context->ns.nsh.count == ARM_NEON_SAVED_STATE64_COUNT) {
+		ctx.v = (fge_vreg_t *)(void *)&context->ns.ns_64.v.q[0];
+		ctx.fpsr = &context->ns.ns_64.fpsr;
+		ctx.fpcr = context->ns.ns_64.fpcr;
+	} else {
+		ctx.v = NULL;
+		ctx.fpsr = NULL;
+		ctx.fpcr = 0;
+	}
+	ctx.read_mem = kernel ? fge_read_kern : fge_read_user;
+	ctx.write_mem = kernel ? fge_write_kern : fge_write_user;
+	ctx.barrier = fge_barrier;
+	ctx.cookie = NULL;
+	ctx.pacga_key = fge_key;
+
+	res = fge_emulate(&ctx, insn, &cls);
+	if (res != FGE_HANDLED) {
+		/* FGE_MEM_FAULT: the original instruction would have faulted; the
+		 * caller's undefined-instruction path reports it. A precise data
+		 * abort is a later refinement (docs/roadmap.md). */
+		return false;
+	}
+
+	for (r = 0; r < 29; r++) {
+		ss->x[r] = ctx.x[r];
+	}
+	ss->fp = ctx.x[29];
+	ss->lr = ctx.x[30];
+	ss->sp = ctx.sp;
+	ss->pc = ctx.pc;
+	ss->cpsr = (ss->cpsr & 0x0FFFFFFFu) | (ctx.nzcv & 0xF0000000u);
+
+	if ((unsigned)cls < 16) {
+		uint64_t n = os_atomic_inc(&fge_xnu_counts[cls], relaxed);
+		if (fge_mode == 2 && (n & 0xFFFFF) == 0) {
+			kprintf("fge: %s %llu (pc 0x%llx)\n", fge_class_name(cls),
+			    (unsigned long long)n, (unsigned long long)ss->pc);
+		}
+	}
+	return true;
+}
diff --git a/osfmk/arm64/fge_xnu.h b/osfmk/arm64/fge_xnu.h
new file mode 100644
index 0000000..00e464b
--- /dev/null
+++ b/osfmk/arm64/fge_xnu.h
@@ -0,0 +1,26 @@
+/*
+ * XNU glue for FGE (kernel/fge): emulate trapped ARMv8.3-8.5 instructions on
+ * ARMv8.2 CPUs. Called from sleh_synchronous() for ESR_EC_UNCATEGORIZED.
+ *
+ * Copyright (c) 2026, macOS-Pad-6 contributors.
+ * SPDX-License-Identifier: BSD-2-Clause-Patent
+ */
+#ifndef _ARM64_FGE_XNU_H_
+#define _ARM64_FGE_XNU_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <mach/arm/thread_status.h>
+
+/*
+ * Returns true when the instruction at the saved PC was emulated and the
+ * saved state now points past it (or at the branch target). Returns false to
+ * let the caller take its normal path (SIGILL for user code, panic for the
+ * kernel). Boot argument fge=0 disables it, fge=2 also logs every 2^20 traps.
+ */
+bool fge_xnu_handle(arm_context_t *context);
+
+/* Per-class counters, readable by board log probes. */
+extern uint64_t fge_xnu_counts[16];
+
+#endif /* _ARM64_FGE_XNU_H_ */
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index c95210c..3145470 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -59,6 +59,7 @@
 #include <pexpert/arm64/apple_arm64_cpu.h>
 #include <pexpert/arm64/apple_arm64_regs.h>
 #include <pexpert/arm64/board_config.h>
+#include <arm64/fge_xnu.h>
 
 #include <vm/vm_page.h>
 #include <vm/pmap.h>
@@ -1011,6 +1012,10 @@ sleh_synchronous(arm_context_t *context, uint64_t esr, vm_offset_t far, __unused
 			break;
 		}
 #endif /* CONFIG_XNUPOST */
+		/* ARMv8.3-8.5 instructions on ARMv8.2 cores (macOS-Pad-6 FGE). */
+		if (fge_xnu_handle(context)) {
+			break;
+		}
 		handle_uncategorized(&context->ss);
 		break;
 
