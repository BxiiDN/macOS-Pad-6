diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 5bc65a1..d9f40e1 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1801,3 +1801,24 @@ netboot_root(void)
 	return 0;
 }
 #endif
+
+/*
+ * macOS-Pad-6 (pipa): defaults for board features the macOS OS series calls into and this board does not have yet.
+ *  - The owner-verified root (XNU_OWNER_ROOT_AUDIT, with a source storage driver) is absent: no root was accepted
+ *    and no device is the owner root, so an authenticated open the file system refuses stays refused (EAUTH), as in
+ *    unmodified XNU (macos-owner-root-authenticated-open.patch reads these two).
+ *  - exit() calls the board's native_exit_trace when one is linked (macos-droidvm-k27-parity.patch); this board has
+ *    none yet, so a no-op stands in (not weak: that would be a chained-fixup import XnuPrelink refuses).
+ */
+#if !(defined(XNU_OWNER_ROOT_AUDIT) && XNU_OWNER_ROOT_AUDIT)
+volatile int native_owner_root_accepted = 0;
+volatile dev_t native_owner_root_mount_device = NODEV;
+#endif
+void native_exit_trace(int pid, const char *name, int status);
+void
+native_exit_trace(int pid, const char *name, int status)
+{
+	(void)pid;
+	(void)name;
+	(void)status;
+}
