From: macOS-Pad-6 contributors
Subject: [PATCH] arm64e without FEAT_PAuth: null PAC (HAS_NULL_PAC)

Base: xnu ac9718fb1af618d5ce8678d0dc6e8a58f252216f (xnu-12377.121.6, macOS 26.5) + UniXNU arm64e
series + devices/pipa SoC layer + macOS 26.5 OS series (UniXNU macOS series
without the Darwin 26 patches) + zzyf-pipa-amp. Generated by
scripts/gen_tahoe_patches.py; do not edit.

---
diff --git a/osfmk/arm/machine_routines_apple.c b/osfmk/arm/machine_routines_apple.c
index e2a736c..b0f9aa9 100644
--- a/osfmk/arm/machine_routines_apple.c
+++ b/osfmk/arm/machine_routines_apple.c
@@ -249,7 +249,7 @@ ml_default_jop_pid(void)
 #if HAS_PARAVIRTUALIZED_PAC
 	vmapple_pac_get_default_keys();
 	return vmapple_default_jop_pid;
-#elif HAS_NATIVE_PAC
+#elif HAS_NATIVE_PAC || HAS_NULL_PAC
 	/*
 	 * Every process signs with the one architectural key set, so this value
 	 * selects no key. It must not be 0: the shared region and dyld pagers
diff --git a/osfmk/arm64/machine_routines_asm.s b/osfmk/arm64/machine_routines_asm.s
index 4aa57b7..0792ee7 100644
--- a/osfmk/arm64/machine_routines_asm.s
+++ b/osfmk/arm64/machine_routines_asm.s
@@ -107,7 +107,7 @@ Lcre_start_\@:
 	.globl EXT(ml_enable_user_jop_key)
 LEXT(ml_enable_user_jop_key)
 	ARM64_PROLOG
-#if HAS_NATIVE_PAC
+#if HAS_NATIVE_PAC || HAS_NULL_PAC
 	/* The kernel and every process share one key set; nothing to switch. */
 	mov		x0, #0
 	ret
@@ -129,7 +129,7 @@ LEXT(ml_enable_user_jop_key)
 	.globl EXT(ml_disable_user_jop_key)
 LEXT(ml_disable_user_jop_key)
 	ARM64_PROLOG
-#if HAS_NATIVE_PAC
+#if HAS_NATIVE_PAC || HAS_NULL_PAC
 	ret
 #endif /* HAS_NATIVE_PAC */
 #if HAS_PARAVIRTUALIZED_PAC
@@ -1807,6 +1807,10 @@ LEXT(monitor_call)
  * x1 is used to return the result.
  */
 .macro COMPUTE_THREAD_STATE_HASH
+#if HAS_NULL_PAC
+	/* No PACGA on this CPU: a constant hash, so sign and check always agree. */
+	mov		x1, #0
+#else
 	/*
 	 * Mask off the carry flag for EL0 states so we don't need to re-sign when
 	 * that flag is touched by the system call return path.
@@ -1850,6 +1854,7 @@ LEXT(monitor_call)
 
 	bfxil   x17, x1, #0, #32			/* add binding state */
 	pacga	x1, x17, x5					/* X17(x5) hash (gkey + x16 hash) */
+#endif /* HAS_NULL_PAC */
 .endm
 
 /*
@@ -2050,6 +2055,11 @@ LEXT(fill32_nt)
 	.globl EXT(ml_addrperm_pacga)
 LEXT(ml_addrperm_pacga)
 	ARM64_PROLOG
+#if HAS_NULL_PAC
+	/* No PACGA: no permutation (it only hides addresses in logs). */
+	orr		x0, x0, #0x1
+	ret
+#endif /* HAS_NULL_PAC */
 	mov    w17, #PACGA_TAG_ADDRPERM
 	pacga  x16, x17, x0
 	/* Force the output to not be NULL, so debug can tell them apart */
@@ -2073,6 +2083,11 @@ LEXT(ptrauth_utils_sign_blob_generic)
 	ARM64_STACK_PROLOG
 	PUSH_FRAME
 
+#if HAS_NULL_PAC
+	/* No PACGA: every blob signs to 0, so signing and checking agree. */
+	mov		x0, #0
+	b		Lsign_ret
+#endif /* HAS_NULL_PAC */
 	cbz		x0, Lsign_ret
 	lsr		x10, x1, #0x3		// x10 = rounds - number of full words
 	and		x9, x1, #0x7		// x9 = ntrailing - number trailing bytes
diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index 51fdc9d..75404db 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -738,7 +738,7 @@
 #define SCTLR_EOS_DEFAULT         (SCTLR_EOS)
 #endif
 
-#if   HAS_APPLE_PAC
+#if   HAS_APPLE_PAC && !HAS_NULL_PAC
 #define SCTLR_PAC_KEYS_DEFAULT  SCTLR_PAC_KEYS_ENABLED
 #else /* !HAS_APPLE_PAC */
 #define SCTLR_PAC_KEYS_DEFAULT  0
diff --git a/pexpert/pexpert/arm64/BCM2837.h b/pexpert/pexpert/arm64/BCM2837.h
index b12c67b..52013c1 100644
--- a/pexpert/pexpert/arm64/BCM2837.h
+++ b/pexpert/pexpert/arm64/BCM2837.h
@@ -31,7 +31,15 @@
  */
 #if defined(__arm64e__)
 #define HAS_APPLE_PAC             1
-#define HAS_NATIVE_PAC            1
+/*
+ * macOS-Pad-6: the board has no FEAT_PAuth (ARMv8.2 cores, e.g. Kryo 585 in
+ * SM8250). The arm64e ABI stays (arm64e processes and kexts), and pointer
+ * authentication is the identity ("null PAC"): no key registers, no SCTLR key
+ * enables, no PACGA in the thread-state hash. Compiler-emitted PAC is rewritten
+ * by tools/isa/pacstrip; what remains traps to FGE. PAC gives no protection.
+ */
+#define HAS_NULL_PAC              1
+#define HAS_NATIVE_PAC            0
 #endif
 
 #ifndef ASSEMBLER
