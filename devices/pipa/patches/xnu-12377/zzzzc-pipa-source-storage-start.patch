diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index d9f40e1..780c612 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -794,6 +794,17 @@ bsd_init(void)
 	/* Initialize the file systems. */
 	bsd_init_kprintf("calling vfsinit\n");
 	vfsinit();
+#if defined(XNU_PIPA_SOURCE_STORAGE) && XNU_PIPA_SOURCE_STORAGE
+	/*
+	 * macOS-Pad-6 (pipa): the source storage runtime (devices/pipa/package/SourceStorage.cpp, linked from
+	 * libShengSourceStorage.a). It returns at once unless native-source-storage=1 and a read-only inspection of
+	 * native-ufs-probe is asked for (PipaStorageGuard.h); it never mounts a root and never writes UFS. A strong
+	 * reference: the archive is force-loaded by the defconfig that defines this switch, and a weak one would be a
+	 * chained-fixup import XnuPrelink refuses.
+	 */
+	extern void native_source_storage_start(void);
+	native_source_storage_start();
+#endif
 #if DEVELOPMENT || DEBUG
 	native_apfs_load_probe();
 	native_mobile_graphics_load_probe();
