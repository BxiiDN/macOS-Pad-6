diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -803,6 +803,16 @@ bsd_init(void)
 	extern void native_source_storage_start(void);
 	native_source_storage_start();
 #endif
+#if defined(XNU_PIPA_BOARD_START) && XNU_PIPA_BOARD_START
+	/*
+	 * macOS-Pad-6 (pipa): the board's display presenter and GPU bring-up (devices/pipa/package/PipaBoardStart.c,
+	 * linked from libPipaGpu.a). It returns at once unless pipa-gop=1 or pipa-gpu=<mode> is on the command line;
+	 * GPU modes that write registers also need pipa-gpu-writes=1. A strong reference, for the reason
+	 * zzzzc-pipa-source-storage-start.patch gives.
+	 */
+	extern void pipa_board_start(void);
+	pipa_board_start();
+#endif
 #if DEVELOPMENT || DEBUG
 	native_apfs_load_probe();
 	native_mobile_graphics_load_probe();
