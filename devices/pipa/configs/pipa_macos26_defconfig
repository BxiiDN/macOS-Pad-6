# Kernel configuration of the macOS Tahoe 26.5 kernel for pipa (SM8250), applied after the arm64e common fragment,
# soc:configs/sm8250.config and os:configs/macos.config. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
#
# The generic arm64e path on this board's cores: ArmDTPlatform, ArmCpu (pipa branch), the source corecrypto and pthread
# providers and the generic timer, from the arm64e fragment. The ARMv8.2 layer (null PAC and the FGE emulator) is the
# device patch series; it has no switch of its own here, because without it this kernel cannot run on SM8250 at all.
#
# Not selected, with the reason in docs/kernel-build.md: storage (NATIVE_UFS: the arm64e ShengUfs recipe builds sheng's
# SM8550 source storage), the owner root chain that needs it, the display (NATIVE_LEGACY_DISPLAY: its recipe needs the
# macOS 26.5 class fixtures) and the GPU (NATIVE_ADRENO: no A650 catalog component).
#
# SPDX-License-Identifier: BSD-2-Clause-Patent

CONFIG_XNU_BUILD_ARCHIVES=y
# corecrypto from source, started by the kernel, as UniXNU-sheng's macOS defconfig. The macOS fragment's "prelinked" mode
# compiles prng_random.c without the source-provider entry (source_corecrypto14_original/_start_once) that the arm64e
# series' OSKext hunk (native-security-init.patch) still calls under XNU_SOURCE_CORECRYPTO14: the first link stopped on
# both (kernel-build.yml, 2026-11-11).
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
# The panic text on the frame buffer from the DT panic region, as UniXNU-pipa's kernel (there is no UART on pipa).
CONFIG_XNU_DT_PANIC_REGION=y
# The macOS kernel collection keeps its linked addresses; the native kernel joins it with chained fixups, as on
# UniXNU-sheng's macOS kernel.
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
# __FILE__ without the build directory. VERIFY() (bsd/sys/mcache.h), IOKit's AssertMacros.h and corecrypto's
# cc_macros.h put __FILE__ into panic and assertion messages; the compiler expands it to the absolute source path,
# here about a hundred characters of runner directories before "bsd/...". With the maps it is the path inside the
# tree ("bsd/net/dlil.c", "refer/corecrypto-2023/..."). Only those message strings change: no code, no condition and
# no symbol does. It shortens __TEXT,__cstring (the kernel's __TEXT has to fit the 26.5 collection's __PRELINK_TEXT,
# docs/kernel-build.md) and makes the kernel independent of where it is built. The first seven flags are
# build-xnu-4k-baseline.sh's default XNU_EXTRA_CFLAGS, which this setting replaces, unchanged.
CONFIG_XNU_EXTRA_CFLAGS="-Wno-reserved-identifier -Wno-pre-c11-compat -Wno-missing-designated-field-initializers -Wno-suggest-override -Wno-unnecessary-virtual-specifier -Wno-suggest-destructor-override -Wno-ms-bitfield-padding -fmacro-prefix-map={tree}/.cache/xnu-work/= -fmacro-prefix-map={tree}/="
# The kernel link also writes ld64's link map (which object put each atom where), for scripts/kernel_size_audit.py.
# It is an extra output file only; the linked kernel does not change.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-map,{tree}/build/kernel-link.map"
