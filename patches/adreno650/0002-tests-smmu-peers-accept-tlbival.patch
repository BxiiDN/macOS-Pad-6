diff --git a/tests/test_client.cpp b/tests/test_client.cpp
index 2de841d..e1d2fbc 100644
--- a/tests/test_client.cpp
+++ b/tests/test_client.cpp
@@ -33,7 +33,11 @@ static int mread64(void *c,size_t at,uint64_t *v)
 {CHECK(c==&mf && at%8==0 && at<=SMMU_BYTES-8);if(mevent())return 1;std::memcpy(v,mmio+at/4,8);return 0;}
 static int mwrite32(void *c,size_t at,uint32_t v)
 {CHECK(c==&mf && at%4==0 && at<=SMMU_BYTES-4);int f=mevent();if(f && !mf.after)return 1;mmio[at/4]=v;return f;}
-static int mwrite64(void *c,size_t at,uint64_t v){(void)c;(void)at;(void)v;CHECK(0);return 1;}
+static int mwrite64(void *c,size_t at,uint64_t v)
+{CHECK(c==&mf && at%8==0 && at<=(SMMU_BYTES)-8);
+ /* Only TLBIVAL (context bank + 0x620): ArmSmmu4K drops small unmaps page by page (ArmSmmu4KSyncContextTlbPages). */
+ CHECK(at>=0x20000 && (at&0xfff)==0x620);
+ int fail=mevent();if(fail && !mf.after)return 1;std::memcpy(mmio+at/4,&v,8);return fail;}
 static int mbarrier(void *c){CHECK(c==&mf);return mevent();}
 struct CpPeer {
     std::vector<uint32_t> regs,writes;
