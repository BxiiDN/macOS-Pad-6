diff --git a/scripts/ufs_soc.py b/scripts/ufs_soc.py
new file mode 100644
index 0000000..b9e8c52
--- /dev/null
+++ b/scripts/ufs_soc.py
@@ -0,0 +1,26 @@
+"""The NATIVE_UFS_<SoC> switch of the UFS host driver (drivers/ShengUfs and its SoC forks) for the board's SoC.
+
+NativeUfs.cpp and GccUfs.h choose the controller's compatible string and the GCC, UFS and SMMU layout by
+NATIVE_UFS_SM6225 or NATIVE_UFS_SM8250; with neither they are the SM8550 (sheng) driver. Both UFS recipes (the
+arm64 driver build and the arm64e source storage) take the SoC from UNIXNU_SOC, which the kernel step exports
+from board.toml [board] soc.
+"""
+import re
+
+# SoCs whose UFS host has its own block in the driver sources. SM8550 is the default and needs no switch.
+SWITCHED = ('SM6225', 'SM8250')
+DEFAULT = 'SM8550'
+
+
+def defines(soc):
+    """Compiler flags for the SoC: [] for SM8550 or no SoC, one -D for a switched SoC. Another SoC is an error:
+    the driver would otherwise probe for the SM8550 controller and silently match nothing."""
+    name = (soc or '').strip().upper()
+    if not name or name == DEFAULT:
+        return []
+    if not re.fullmatch(r'[A-Z]{2}[0-9]{4}[A-Z]?', name):
+        raise SystemExit(f'UNIXNU_SOC={soc!r}: not a SoC name')
+    if name not in SWITCHED:
+        raise SystemExit(f'UNIXNU_SOC={soc}: the UFS driver has no NATIVE_UFS_{name} block (known: '
+                         f'{", ".join((DEFAULT,) + SWITCHED)})')
+    return [f'-DNATIVE_UFS_{name}=1']
