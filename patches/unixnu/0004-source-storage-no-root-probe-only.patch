---
--- a/scripts/build-sheng-source-storage.py
+++ b/scripts/build-sheng-source-storage.py
@@ -203,6 +203,10 @@
              '-DNATIVE_VERIFIED_BLOCK_MULTI_POLICY=1', '-DNATIVE_VERIFIED_POLICY_HANDOFF=1']
     # NativeUfs.cpp selects its controller (compatible string, GCC and SMMU layout) by NATIVE_UFS_<SoC>.
     flags += ufs_soc.defines(os.environ.get('UNIXNU_SOC'))
+    if no_root:
+        # No root from userdata: NativeUfs is built probe-only, without the block devices and the root window
+        # publication (NativeUfsBlock, startRoot, the userdata block test), which such a board never uses.
+        flags.append('-DNATIVE_UFS_PROBE_ONLY=1')
     if os.environ.get('UNIXNU_XNU_TARGET') == 'macosx':
         # The kernel keeps the iOS target triple, so TargetConditionals gives TARGET_OS_OSX 0. The macOS
         # IOStorageFamily has the TARGET_OS_OSX members (doLockUnlockMedia, reportLockability,
